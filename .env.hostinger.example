# Copy this file to .env.hostinger on the VPS. Never commit the real file.

# Public site and Let's Encrypt registration.
ERP_DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com

# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-url-safe-random-hex
JWT_SECRET=replace-with-a-different-random-hex

APP_NAME=Shree Enterprise API
ENVIRONMENT=production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
SESSION_COOKIE_NAME=solar_erp_refresh
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_ENABLED=true

# A single API worker uses the application's bounded in-memory limiter.
RATE_LIMIT_MODE=local
SINGLE_INSTANCE_DEPLOYMENT=true
WEB_CONCURRENCY=1

# Private Cloudflare R2 document bucket. Do not use a public bucket.
STORAGE_TYPE=s3
S3_PROVIDER=r2
S3_BUCKET=private-solar-erp-production
S3_PREFIX=solar-erp
S3_REGION=auto
S3_ENDPOINT_URL=https://00000000000000000000000000000000.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_ADDRESSING_STYLE=path
S3_SSE_ALGORITHM=provider-managed
STORAGE_WRITE_PROBE_INTERVAL_SECONDS=900

MAX_REQUEST_BODY_MB=2
MAX_UPLOAD_MB=20
UPLOAD_CHUNK_KB=512
MALWARE_SCAN_TIMEOUT_SECONDS=60
REQUIRE_MALWARE_SCAN=true

DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
MAX_CONCURRENT_REQUESTS=5

# Used only by the one-time bootstrap-admin command. Change it after login.
SEED_COMPANY_NAME=Shree Enterprise
SEED_COMPANY_CODE=SHREE
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

# Optional: replace with a reviewed immutable ClamAV image digest.
CLAMAV_IMAGE=clamav/clamav:stable
