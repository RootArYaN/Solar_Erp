# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, lint, type-check and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest-report.xml

# Packaging and build output
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Local databases and database sidecars
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Database exports and local process state
*.dump
*.sql
*.sql.gz
celerybeat-schedule*
gunicorn.pid

# Keep versioned PostgreSQL bootstrap scripts used by Docker test infrastructure.
!infra/
!infra/postgres/
!infra/postgres/init/
!infra/postgres/init/*.sql

# User-uploaded/runtime files. Preserve only the required directory skeleton.
storage/*
!storage/active/
!storage/temp/
storage/active/*
storage/temp/*
!storage/active/.gitkeep
!storage/temp/.gitkeep

# Isolated integration/performance test state and generated diagnostics.
storage-test/
reports/
