# Copy to .env for local development. Never commit real secrets.

# Application
APP_NAME=Solar ERP API
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://solar_erp:change-this-password@127.0.0.1:5432/solar_erp
DATABASE_SSLMODE=prefer

# Authentication and sessions
JWT_SECRET=replace-this-development-secret-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_CLOCK_SKEW_SECONDS=30
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
REFRESH_ROTATION_GRACE_SECONDS=30
SESSION_COOKIE_NAME=solar_erp_refresh
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Browser security and proxy trust
CSRF_ENABLED=true
CSRF_HEADER_NAME=X-CSRF-Token
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
TRUST_PROXY_HEADERS=false

# Request and login rate limiting
RATE_LIMIT_MODE=local
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_READ_PER_MINUTE=180
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=45
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_MAX_KEYS=5000
LOGIN_LIMIT=8
LOGIN_WINDOW_SECONDS=300

# File storage and upload validation
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_TEMP_PATH=./storage/temp
ALLOW_LOCAL_STORAGE_PRODUCTION=false
MAX_REQUEST_BODY_MB=2
MAX_UPLOAD_MB=20
UPLOAD_CHUNK_KB=512
MALWARE_SCAN_COMMAND=
MALWARE_SCAN_TIMEOUT_SECONDS=60
REQUIRE_MALWARE_SCAN=false

# Pagination and idempotency
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=180
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=300

# Database pool and application concurrency
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1200
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
THREAD_POOL_WORKERS=8
MAX_CONCURRENT_REQUESTS=5
SLOW_REQUEST_MS=750

# Development bootstrap. Replace the password before first startup.
SEED_COMPANY_NAME=Shree Enterprise
SEED_COMPANY_CODE=SHREE
SEED_ADMIN_NAME=Local Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@solarerp.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
