# Production template. Copy values into the cloud platform's configuration and
# secret manager; do not deploy this file with real credentials.

APP_NAME=Shree Enterprise API
ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://solar_erp:replace-password@db.example.com:5432/solar_erp
DATABASE_SSLMODE=verify-full

JWT_SECRET=replace-this-development-secret-with-a-random-64-character-production-secret
JWT_ALGORITHM=HS256
JWT_CLOCK_SKEW_SECONDS=30
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
REFRESH_ROTATION_GRACE_SECONDS=30
SESSION_COOKIE_NAME=solar_erp_refresh
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=erp.example.com

CSRF_ENABLED=true
CSRF_HEADER_NAME=X-CSRF-Token
FRONTEND_ORIGINS=https://erp.example.com
TRUSTED_HOSTS=erp.example.com
TRUST_PROXY_HEADERS=true
# Restrict to the private reverse-proxy addresses. Use * only when the API has
# no direct network path from untrusted clients.
FORWARDED_ALLOW_IPS=127.0.0.1

RATE_LIMIT_MODE=gateway
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_READ_PER_MINUTE=180
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=45
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_MAX_KEYS=5000
LOGIN_LIMIT=8
LOGIN_WINDOW_SECONDS=300

STORAGE_TYPE=s3
STORAGE_PATH=./storage
STORAGE_TEMP_PATH=/tmp/solar-erp
S3_PROVIDER=r2
S3_BUCKET=private-solar-erp-production
S3_PREFIX=solar-erp
S3_REGION=auto
# Replace the 32-zero account ID with the Cloudflare account ID.
S3_ENDPOINT_URL=https://00000000000000000000000000000000.r2.cloudflarestorage.com
# Use a bucket-scoped R2 Object Read & Write token from the secret manager.
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
# R2 automatically encrypts objects and rejects AWS SSE request headers.
S3_SSE_ALGORITHM=provider-managed
S3_KMS_KEY_ID=
# HeadBucket runs on every readiness check; the billable write test is cached.
STORAGE_WRITE_PROBE_INTERVAL_SECONDS=900
MAX_REQUEST_BODY_MB=2
MAX_UPLOAD_MB=20
UPLOAD_CHUNK_KB=512
MALWARE_SCAN_COMMAND=python /app/scripts/clamd_scan.py --host malware-scanner --port 3310 {path}
MALWARE_SCAN_TIMEOUT_SECONDS=60
REQUIRE_MALWARE_SCAN=true

DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=180
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=300

DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1200
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
THREAD_POOL_WORKERS=8
MAX_CONCURRENT_REQUESTS=5
SLOW_REQUEST_MS=750

# Container runtime. Keep one worker until connection-pool and memory sizing
# have been load tested; scale with replicas first.
PORT=8000
WEB_CONCURRENCY=1
