# Copy to .env.deploy and replace every image with an immutable registry digest.
# Compose reads backend application settings separately from BACKEND_ENV_FILE.
API_IMAGE=registry.example.com/solar-erp-api@sha256:replace-with-immutable-digest
FRONTEND_IMAGE=registry.example.com/solar-erp-frontend@sha256:replace-with-immutable-digest
CLAMAV_IMAGE=registry.example.com/approved-clamav@sha256:replace-with-immutable-digest
BACKEND_ENV_FILE=./backend/.env.production
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
