# Public browser configuration only. Never place database credentials, JWT
# secrets, storage keys, or other private values in VITE_* variables.
VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=solar_erp_csrf

# Local Vite development server
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_DEV_EXPOSE=false
VITE_ALLOWED_HOSTS=
